# Test of orbital Hall conductivity (OHC) for fcc platinum.
# Reuses the spin-Hall Kubo machinery with the atomic-centered orbital
# angular momentum operator L in place of the spin operator.




ohc_freq_scan = false
ohc_alpha = 1
ohc_beta  = 2
ohc_gamma = 3

berry = true
berry_task = eval_ohc
berry_kmesh = 8
berry_curv_unit = ang2
#berry_curv_adpt_kmesh = 5
#berry_curv_adpt_kmesh_thresh = 100.0

fermi_energy_min = 6
fermi_energy_max = 26
fermi_energy_step = 0.1

num_bands         =   40
num_wann          =   18

dis_win_min       =  0.0d0
dis_win_max       =  60.0d0
dis_froz_min      =  0.0d0
dis_froz_max      =  30.00d0
dis_num_iter      =  2000
dis_conv_tol      = 1.0e-10
conv_tol          = 1.0e-10
conv_window       = 40
num_iter          = 2000
guiding_centres = T

spinors = true
begin projections
Pt: d;s;p
end projections

begin unit_cell_cart
bohr
-3.703863220455861e0 0.000000000000000e0 3.703863220455861e0
 0.000000000000000e0 3.703863220455861e0 3.703863220455861e0
-3.703863220455861e0 3.703863220455861e0 0.000000000000000e0
end unit_cell_cart

begin atoms_frac
Pt  0.000  0.000  0.000
end atoms_frac

mp_grid           =  4   4   4

